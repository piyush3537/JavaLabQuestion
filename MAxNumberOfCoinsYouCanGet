import java.util.Arrays;

public class Solution {
    public int maxCoins(int[] piles) {
        Arrays.sort(piles);
        int n = piles.length / 3;
        int totalCoins = 0;
        for (int i = n; i < piles.length; i += 2) {
            totalCoins += piles[i];
        }
        return totalCoins;
    }
}
